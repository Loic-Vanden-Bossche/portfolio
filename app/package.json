{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "node scripts/deploy.mjs",
    "prod": "yarn build && yarn start",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:photos": "node scripts/optimize-photo-assets.mjs",
    "postinstall": "prisma generate",
    "prepare": "cd .. && app/node_modules/.bin/husky app/.husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "^9.7.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix",
    "*.{json,css,scss,md,mdx,yml,yaml}": "prettier --write"
  }
}
